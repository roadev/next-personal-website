---
import { locales, person, type Locale } from '../data/profile';
import { homePath, languageName, sections, ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const home = homePath[locale];
---

<header class="site-header">
	<div class="bar">
		<p class="side side-start">
			<Icon name="pin" size={14} />
			{person.location[locale]}
		</p>

		<nav class="pill sections" aria-label={ui.sectionsNav[locale]}>
			<ul role="list">
				{
					sections.map((id) => (
						<li data-section={id}>
							<a href={`${home}#${id}`}>{ui.nav[id][locale]}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="side side-end">
			<nav class="pill languages" aria-label={ui.languageNav[locale]}>
				<ul role="list">
					{
						locales.map((code) => (
							<li>
								<a
									href={homePath[code]}
									hreflang={code}
									lang={code}
									aria-current={code === locale ? 'page' : undefined}
								>
									<span aria-hidden="true">{code.toUpperCase()}</span>
									<span class="visually-hidden">{languageName[code]}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<time class="clock" data-clock data-locale={locale} data-time-zone={person.timeZone} title={ui.localTime[locale]} hidden
			></time>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>('.site-header');
	if (header) {
		const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
		update();
		window.addEventListener('scroll', update, { passive: true });
	}

	const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
	if (clock) {
		const format = new Intl.DateTimeFormat(clock.dataset.locale, {
			hour: '2-digit',
			minute: '2-digit',
			timeZone: clock.dataset.timeZone,
		});
		const tick = () => {
			clock.textContent = format.format(new Date());
		};
		tick();
		clock.hidden = false;
		setInterval(tick, 15_000);
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0.75rem var(--gutter);
	}

	/* Fade content out under the bar so it does not show between the pills. */
	.site-header::before {
		content: '';
		position: absolute;
		inset: 0 0 -1rem;
		z-index: -1;
		background: linear-gradient(rgb(10 10 10 / 0.85) 55%, transparent);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	/* Keep the background glow visible at the top; the fade appears once the page scrolls. */
	.site-header[data-scrolled]::before {
		opacity: 1;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
	}

	.side {
		display: none;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.875rem;
		color: var(--text);
	}

	.side-start svg {
		color: var(--accent);
	}

	.pill {
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		background: rgb(10 10 10 / 0.6);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
	}

	.pill ul {
		display: flex;
		gap: 0.125rem;
		padding: 0.25rem;
	}

	.sections ul {
		overflow-x: auto;
		scrollbar-width: none;
	}

	.pill a {
		display: block;
		padding: 0.375rem 0.625rem;
		border-radius: var(--radius-pill);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.4;
		white-space: nowrap;
		color: var(--text);
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.pill a:hover {
		background: var(--surface-hover);
	}

	.pill a:focus-visible {
		outline-offset: -2px;
		border-radius: var(--radius-pill);
	}

	.languages a[aria-current='page'] {
		background: rgb(255 255 255 / 0.14);
	}

	.clock {
		font-variant-numeric: tabular-nums;
	}

	/* Small phones: drop the last anchor so the bar fits on one line. */
	@media (max-width: 479px) {
		[data-section='education'] {
			display: none;
		}
	}

	@media (min-width: 480px) {
		.pill a {
			padding-inline: 0.875rem;
			font-size: 0.875rem;
		}
	}

	/* Wide screens: location on the left, sections centred, language and clock on the right. */
	@media (min-width: 1100px) {
		.bar {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
		}

		.side {
			display: flex;
		}

		.side-end {
			justify-content: flex-end;
			gap: 1rem;
		}
	}

	@media (max-width: 1099px) {
		/* Below the wide layout only the language switch is visible on the right. */
		.side-end {
			display: flex;
		}

		.clock {
			display: none;
		}
	}
</style>
